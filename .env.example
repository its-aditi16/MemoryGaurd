# Memory backend: local (SQLite + sentence-transformers) or hindsight
MEMORY_BACKEND=local

# LLM provider: groq | anthropic | openai (any OpenAI-compatible endpoint) | none
# With "none" the agent answers from deterministic templates (demo still works).
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_BASE_URL=

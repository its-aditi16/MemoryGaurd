# Memory backend: hindsight (Hindsight memory server, started by npm run dev) or local (SQLite + sentence-transformers)
MEMORY_BACKEND=local

# LLM provider: groq | anthropic | openai (any OpenAI-compatible endpoint) | none
# With "none" the agent answers from deterministic templates (demo still works).
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_BASE_URL=

# Optional: User-Agent for the Ingest URL feature. Some sites (e.g. Wikipedia) block bots unless
# the User-Agent includes contact details, e.g.  MemoryGuard-demo/0.1 (you@example.com)
FETCH_USER_AGENT=
